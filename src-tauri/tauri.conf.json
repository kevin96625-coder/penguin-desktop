{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "penguin-desktop",
  "version": "0.1.0",
  "identifier": "com.kevinchen.penguin-desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "penguin-desktop",
        "width": 800,
        "height": 600,
        "url": "http://localhost:7364",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
